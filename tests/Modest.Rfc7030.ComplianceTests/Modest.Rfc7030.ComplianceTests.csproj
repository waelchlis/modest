<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <!-- Test names read as sentences; CA1707 wants them to read as identifiers. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="WireMock.Net" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Modest.Server/Modest.Server.csproj" />
    <ProjectReference Include="../Modest.TestSupport/Modest.TestSupport.csproj" />

    <!--
      Reuses ModestServerHarness/TestPki/EstResponse rather than re-implementing a second real-Kestrel
      test host: those fixtures are exactly what this project also needs (see 06-testing-strategy.md
      §6 — "largely the same tests as §5 above, re-tagged"), and the wire-level assertions that already
      run through them in Modest.Server.Tests are the traceability evidence for most RFC sections. The
      Rfc7030Section trait on those tests is what makes them queryable as part of this matrix; what's
      added here is only what doesn't fit naturally as an endpoint-behaviour test.
    -->
    <ProjectReference Include="../Modest.Server.Tests/Modest.Server.Tests.csproj" />
  </ItemGroup>

</Project>
