{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Est": {
      "Port": 8443,
      "CertificatePath": "",
      "CertificatePasswordFile": ""
    },
    "Ops": {
      "Port": 8080
    }
  },
  "Est": {
    "MaxRequestBodyBytes": 65536
  },
  "Authentication": {
    "AllowClientCertificate": true,
    "AllowHttpBasic": true,
    "BasicRealm": "modest",
    "ClientCertificateTrustStorePath": "",
    "AllowUntrustedClientCertificates": false,
    "BasicCredentials": []
  },
  "Issuance": {
    "Mode": "InternalCa",
    "Reenrollment": {
      "RequireMatchingIdentity": true
    },
    "InternalCa": {
      "CertificatePath": "/etc/modest/ca.pfx",
      "CertificatePasswordFile": "/etc/modest/ca.pfx.pass",
      "AdditionalChainCertificatePaths": [],
      "SignatureAlgorithm": "SHA256",
      "ValidityPeriod": "90.00:00:00",
      "BackdateBy": "00:05:00",
      "MinimumRsaKeySizeBits": 2048,
      "AllowedEllipticCurves": [ "nistP256", "nistP384", "nistP521" ],
      "AllowRsa": true,
      "AllowEllipticCurve": true,
      "EnhancedKeyUsageOids": [ "1.3.6.1.5.5.7.3.2" ],
      "KeyUsages": [ "DigitalSignature", "KeyEncipherment" ],
      "CopySubjectAlternativeNames": true,
      "RequireSubjectOrSan": true
    },
    "HttpDelegate": {
      "BaseAddress": "https://ca.internal.example.com/",
      "IssuePath": "/api/v1/issue",
      "BasicAuthUsername": "",
      "BasicAuthPasswordFile": "",
      "StaticCaChainPath": "/etc/modest/upstream-chain.pem",
      "TimeoutSeconds": 30,
      "MaxRetryAttempts": 3,
      "MaxCsrSizeBytes": 16384
    }
  }
}
